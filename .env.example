# Echo v2 environment configuration.
# Copy to `.env` and fill in real values. `.env` is gitignored.

# PostgreSQL — used by the persistence layer (SQLAlchemy 2 async + psycopg3).
# Same URL form for sync (Alembic) and async (app): do not strip `+psycopg`.
DATABASE_URL=postgresql+psycopg://echo:echo@localhost:5432/echo

# Symmetric key for encrypting provider credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Paste the 44-char url-safe base64 string below. Required in non-test environments.
ECHO_CREDENTIAL_KEY=

# Default region for phone-number normalization (E.164). ISO 3166-1 alpha-2.
# Used when a phone number lacks an explicit country code.
ECHO_DEFAULT_PHONE_REGION=IL

# Green API — partner token for provisioning + sending from the user's WhatsApp.
GREEN_API_PARTNER_TOKEN=
GREEN_API_PARTNER_URL=https://api.green-api.com

# 360dialog — Echo Business Bot (conversational interface).
# D360_API_KEY is the per-phone-number key from the 360dialog dashboard.
# D360_WEBHOOK_SECRET is a bearer token you generate; configure it in the
# 360dialog dashboard so incoming webhooks carry it in the Authorization header.
D360_API_KEY=
D360_WEBHOOK_SECRET=

# OpenAI — powers the LLM time parser fallback (regex parser handles common cases).
OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-4.1

# Scheduler tuning (optional).
SCHEDULER_LEASE_SECONDS=300
SCHEDULER_POLL_INTERVAL=5

# Chat ingestion tuning (optional).
# Quiet period (seconds) after the last inbound message before a chat is
# eligible for analysis. Default 300 (5 minutes).
CHAT_QUIET_PERIOD_SECONDS=300

# If true, only private chats (chat_id ending in @c.us) are ingested.
# Set to false to also ingest group chats (@g.us). Default true.
CHAT_PRIVATE_ONLY=true

# Chat analysis worker (disabled by default).
# Set to true to start the analysis worker loop in the app lifespan.
# POC invariant: enable in exactly one process.
CHAT_ANALYSIS_ENABLED=false
CHAT_ANALYSIS_POLL_INTERVAL=60

# Digest worker (disabled by default).
DIGEST_ENABLED=false
DIGEST_POLL_INTERVAL=300
# WhatsApp template name for the morning digest (must be approved in 360dialog).
# morning_waiting_digest5 = template with a URL button containing a dynamic
# variable (the waiting-list session token).
DIGEST_TEMPLATE_NAME=morning_waiting_digest5

# Waiting-list mini web app.
# The Echo bot's WhatsApp phone number (used for the "back to WhatsApp" link).
ECHO_BOT_PHONE=
# Session token TTL in hours (default 48).
ECHO_WAITING_LIST_TOKEN_TTL_HOURS=48
