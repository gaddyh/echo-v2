# Echo v2 environment configuration.
# Copy to `.env` and fill in real values. `.env` is gitignored.

# PostgreSQL — used by the persistence layer (SQLAlchemy 2 async + psycopg3).
# Same URL form for sync (Alembic) and async (app): do not strip `+psycopg`.
DATABASE_URL=postgresql+psycopg://echo:echo@localhost:5432/echo

# Symmetric key for encrypting provider credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Paste the 44-char url-safe base64 string below. Required in non-test environments.
ECHO_CREDENTIAL_KEY=

# Default region for phone-number normalization (E.164). ISO 3166-1 alpha-2.
# Used when a phone number lacks an explicit country code.
ECHO_DEFAULT_PHONE_REGION=IL

# Green API — partner token for provisioning + sending from the user's WhatsApp.
GREEN_API_PARTNER_TOKEN=
GREEN_API_PARTNER_URL=https://api.green-api.com

# 360dialog — Echo Business Bot (conversational interface).
# D360_API_KEY is the per-phone-number key from the 360dialog dashboard.
# D360_WEBHOOK_SECRET is a bearer token you generate; configure it in the
# 360dialog dashboard so incoming webhooks carry it in the Authorization header.
D360_API_KEY=
D360_WEBHOOK_SECRET=

# OpenAI — powers the LLM time parser fallback (regex parser handles common cases).
OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-4.1

# Scheduler tuning (optional).
SCHEDULER_LEASE_SECONDS=300
SCHEDULER_POLL_INTERVAL=5
